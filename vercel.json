{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/activate-wave",
      "schedule": "*/7 * * * *"
    },
    {
      "path": "/api/cron/expire-slots",
      "schedule": "* * * * *"
    }
  ]
}